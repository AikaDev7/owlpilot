# Copy this file to server/.env and fill in the values. Never commit .env.

# --- server/.env ---
PORT=3000
GEMINI_API_KEY=your_gemini_key_here
# Optional: GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite  (tried if the main model keeps failing)

# --- app/.env (not secret, just your computer's Wi-Fi IP so Expo Go can reach the server) ---
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
