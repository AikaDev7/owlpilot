{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(git branch --show-current)",
      "Bash(npx tsc --noEmit)",
      "Bash(node --check:*)",
      "Bash(curl localhost:*)",
      "Bash(curl -s localhost:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./server/.env)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./app/src/data/sections.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edit.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env-commit.sh" }]
      }
    ]
  }
}
